# Hardened deployment secrets template (FI-like). Copy to .env, fill values,
# then: umask 077 && chmod 600 .env
# NEVER commit .env. Generate secrets with a CSPRNG (e.g. `openssl rand -base64 32`).
# See docs/deployment/hardened.md.

# --- Core ---
PLEXICHAT_PUBLIC_SERVER_URL=https://chat.example.invalid
NO_STRICT_CONFIG=false
PLEXICHAT_CONNECT_SRC='self'
# Optional: restrict compose fetch behavior per docker-compose.yml policy
# ALLOW_DEV_COMPOSE=0
# ALLOW_DOCKERHUB_FALLBACK=0

# --- PostgreSQL (least privilege: app user owns only app DB/schema; no superuser) ---
POSTGRES_HOST=db
POSTGRES_DBNAME=plexichat
POSTGRES_USER=plexichat_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM
# Use verify-full with CA/cert when DB is not on the same trusted network.
POSTGRES_SSLMODE=require

# --- Valkey ---
VALKEY_HOST=valkey
VALKEY_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM
# VALKEY_SSL=true  # enable when Valkey TLS is configured end-to-end

# --- Object storage (RustFS/S3, least privilege: bucket-scoped key, no console admin reuse) ---
S3_BUCKET=plexichat-media
S3_REGION=us-east-1
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=CHANGE_ME_LEAST_PRIVILEGE_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_LEAST_PRIVILEGE_SECRET_KEY
S3_PUBLIC_URL=
RUSTFS_CORS_ALLOWED_ORIGINS=

# --- ClamAV (required in hardened profile) ---
SCANNER_HOST=clamav
SCANNER_PORT=3310

# --- Backups (restic) ---
BACKUP_RESTIC_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_KEEP_YEARLY=0
# Optional encrypted offsite secondary repo (set both) — protects against host loss.
# BACKUP_SECONDARY_REPO=s3:s3.example.invalid/plexichat-backups
# BACKUP_SECONDARY_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM

# --- Bootstrap/key material (sensitive; protect /home/plexichat/.plexichat and keyrings) ---
# Set/protect per encryption model. Losing key material makes encrypted data unrecoverable.
# PLEXICHAT_SYSTEM_KEY=...
# PLEXICHAT_MESSAGE_KEY=...
# PLEXICHAT_MEDIA_KEY=...

# --- Passkeys/WebAuthn (must match public origin) ---
PASSKEY_RP_ID=chat.example.invalid
PASSKEY_ORIGIN=https://chat.example.invalid

# --- Registration policy (FI-like default: closed; enable deliberately) ---
ALLOW_REGISTRATION=false
