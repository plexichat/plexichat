mistune==3.3.4
# click pinned to 8.3.3+ clears PYSEC-2026-2132 (pip-audit)
click==8.3.3

# Image Processing
pillow==12.3.0
imagehash==4.3.2

# Document Generation
# reportlab is BSD-3-Clause. It replaced fpdf2 (LGPL-3.0-only) for PDF export.
# ODT export has no permissively-licensed equivalent, so it is written directly
# (a zip of XML) rather than pulling in odfpy's GPL/LGPL metadata.
reportlab==5.0.1
# Spreadsheet import/export for PlexiSum XLSX bridge
openpyxl==3.1.5

# Safe Regex (ReDoS protection)
# google-re2 pinned to date-stamped calver release for strict PEP 440 compliance
google-re2==1.1.20251105

# QR Code Generation
qrcode[pil]==8.2

# S3-compatible Storage (optional)
boto3==1.43.56

# PlexiSum container compression (zstd). Hard dependency — the container
# encoder always zstd-compresses and never silently falls back to raw.
zstandard==0.25.0
# msgpack pinned to 1.2.1+ clears GHSA-xxxx (pip-audit)
msgpack==1.2.1

# Push notifications
# PyJWT is required for token-based APNs HTTP/2 push delivery
# (replaces the now-removed ``# TODO`` stub in push/manager.py).
# Pinned to 2.15.0+ to clear CVE-2026-101918 (pip-audit); 2.14.0+ cleared
# CVE-2026-102274.
PyJWT==2.15.0
# h2 pinned to 4.4.1+ clears CVE-2026-71554 (pip-audit)
h2==4.4.1
# pywebpush is the Web Push (VAPID) delivery client used by push/manager.py's
# _send_web_push. It performs the AES128GCM/ECE encryption of the payload and
# the signed POST to the browser push service, so it is a hard dependency for
# the ``web`` platform (not replaceable by anything already in requirements).
pywebpush==2.4.0

# System metrics (runtime): serves the admin system panel and the self-test
