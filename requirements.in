# Plexichat Server Requirements
#
# Runtime (production) dependencies only, pinned deliberately. This file is the
# policy list: several pins exist purely to clear a specific advisory, and the
# reason is recorded inline. Test frameworks and developer tooling live in
# requirements-dev.in so they are never shipped in the runtime image or pulled
# into the production audit surface.
#
#   uv pip compile requirements.in --python-version 3.14 \
#       --generate-hashes -o requirements.txt
#
# materialises the full transitive tree (with integrity hashes) used by the
# Dockerfile and by the pip-audit / osv-scanner CI jobs.
#
# Optional system dependencies:
# - ffmpeg/ffprobe: Required for video metadata extraction (duration, resolution)
#   Install via: apt install ffmpeg (Linux), brew install ffmpeg (macOS),
#   or download from https://ffmpeg.org/download.html (Windows)
#   Without ffprobe, video uploads work but metadata won't be extracted.
#
# - aiortc dependencies: opus, srtp, libvpx for WebRTC media codecs
#   Linux: apt install libopus-dev libsrtp2-dev libvpx-dev
#   macOS: brew install opus srtp libvpx
#   Windows: Download pre-built binaries or use vcpkg
#
# - HSM / TPM (optional, hardware-backed KEK):
#   pkcs11 (modern backend, preferred) or PyKCS11 (legacy fallback) for
#   HSM via PKCS#11; tpm2-pytss for TPM 2.0. Install only where hardware
#   (or SoftHSM / swtpm) is present, e.g.:
#   pip install "pkcs11>=0.7" "tpm2-pytss>=2.0"
#   Without them the vault falls back to env / machine-local keys.

# Web Framework
# starlette pinned to 1.3.1+ clears CVE-2026-48817, CVE-2026-48818,
# CVE-2026-54282, CVE-2026-54283 (pip-audit 16-CVE baseline)
fastapi==0.140.2
uvicorn[standard]==0.51.0
starlette==1.3.1

# Database
sqlalchemy==2.0.51
# pg8000 is the PostgreSQL driver (src/core/database/engines/postgres.py).
# BSD-3-Clause and pure Python, replacing psycopg/psycopg2 (LGPL-3.0-only): the
# runtime tree ships no copyleft. It speaks DB-API 2.0 with 'format' paramstyle,
# which is what the data layer already emits, and connection pooling is handled
# in-tree by the shared engines/pool.py (no SQLAlchemy pool at runtime).
pg8000==1.31.5
# Two GLIDE packages on purpose, not redundancy: the blocking client
# (glide_sync) is used off the event loop and the async client (glide)
# is used on it. A single handle cannot serve both -- see
# src/core/database/valkey_client/base.py.
valkey-glide==2.5.2
valkey-glide-sync==2.5.0

# Authentication & Security
argon2-cffi==25.1.0
# cryptography pinned to 50.0.0+ clears PYSEC-2026-3552 (pip-audit)
cryptography==50.0.0
pyotp==2.10.0
webauthn==3.0.0
xxhash==3.8.1
# authlib pinned to 1.6.12+ clears PYSEC-2026-25, PYSEC-2026-188 (pip-audit)
authlib==1.6.12
# SECURITY: defusedxml is required for safe SVG parsing in
# Plexichat's media/SVG-XSS sanitizer. Stating it here makes
# ``pip install plexichat`` pull it in transitively.
defusedxml==0.7.1

# Validation & Serialization
pydantic==2.13.4
email-validator==2.3.0

# Configuration
PyYAML==6.0.3

# HTTP Client (webhooks, link previews, federation, OAuth, APNs, Web Push)
# httpx is the one async client for the whole server: it covers HTTP/1.1 and
# HTTP/2, so there is no second async stack to maintain.
# httpx[http2] pulls in h2 for the APNs HTTP/2 transport.
httpx[http2]==0.28.1
# requests is kept for synchronous call sites (CLI tools, the self-test
# harness, threaded transcription uploads). Note it is also a hard runtime
# requirement of pywebpush below, so it cannot be dropped from this tree.
requests==2.34.2
# urllib3 pinned to 2.8.0+ clears CVE-2026-97687, CVE-2026-97688 and
# CVE-2026-97689 (pip-audit); it is a transitive dependency of requests and
# botocore, so it is pinned here to keep a later resolution from regressing it.
urllib3==2.8.0
# idna pinned to 3.15+ clears PYSEC-2026-215 (pip-audit)
idna==3.15
# aiohttp is no longer imported by our code — the SFU adapters make their
# outbound calls with httpx — but pywebpush requires it at runtime, so it stays
# in the tree. Pinned so a future transitive bump cannot reintroduce an
# advisory: 3.14.1+ clears CVE-2026-54273..54280 (pip-audit).
aiohttp==3.14.3

# WebSocket
websockets==16.1.1
websocket-client==1.9.0

# WebRTC / SFU
aiortc==1.15.0

